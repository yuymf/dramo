# === Dramo Configuration ===

# Database password (auto-generated by deploy/setup-dramo.sh)
DB_PASSWORD=dramo_secret

# Encryption key for LLM config storage (64 hex chars = 32 bytes)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# AgentOS internal communication key
AGENTOS_KEY=default_agentos_key

# Public-facing URL (change for production domain)
PUBLIC_URL=http://localhost

# Port to expose (default: 80)
PORT=80

# === LLM API Keys ===
# Optional here — users can also configure their own keys in the UI.
# Provided keys here act as system-wide fallback.
AI_PROVIDER=openai

# OpenAI / OpenAI-compatible
# OPENAI_API_KEY=sk-xxx
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_MODEL_ID=gpt-4-turbo-preview

# Tencent Hunyuan
# HUNYUAN_OPENAPI_KEY=
# HUNYUAN_OPENAPI_URL=
# HUNYUAN_MODEL_ID=hunyuan-turbos-latest

# Session cookie signing
# SESSION_SECRET=

# Stable Diffusion worker pool (A1111-compatible). At least two slots.
# SD_WORKERS=[{"id":"sd-1","baseUrl":"http://127.0.0.1:7860","weight":1,"capabilities":["txt2img","img2img"]},{"id":"sd-2","baseUrl":"http://127.0.0.1:7861","weight":1,"capabilities":["txt2img"]}]

# === LLM Tuning (optional) ===
# LLM_TIMEOUT_SECONDS=90
# LLM_TIMEOUT_LONG_SECONDS=180
# LLM_MAX_RETRIES=2
# LLM_CONCURRENCY=3
