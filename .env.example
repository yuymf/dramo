# === Dramo Configuration ===

# Database password (auto-generated by deploy/setup-dramo.sh)
DB_PASSWORD=dramo_secret

# Encryption key for LLM config storage (64 hex chars = 32 bytes)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Mapped to AGENTOS_SECURITY_KEY in api + agentos containers
AGENTOS_KEY=default_agentos_key

# Public-facing URL (change for production domain)
PUBLIC_URL=http://localhost

# Port to expose (default: 80)
PORT=80

# Stable Diffusion worker pool (A1111-compatible). Compose injects this into api.
# Docker: do not use 127.0.0.1 — that is the api container, not the host SD.
# Local `npm run dev` can omit this; code defaults to 127.0.0.1:7860 and :7861.
# SD_WORKERS=[{"id":"sd-1","baseUrl":"http://<sd-host>:7860","weight":1,"capabilities":["txt2img","img2img"]},{"id":"sd-2","baseUrl":"http://<sd-host>:7861","weight":1,"capabilities":["txt2img"]}]

# === AgentOS LLM tuning (optional) ===
# LLM_TIMEOUT_SECONDS=90
# LLM_TIMEOUT_LONG_SECONDS=180
# LLM_MAX_RETRIES=2
# LLM_CONCURRENCY=3
