# === Dramo Configuration (Docker Compose) ===
# Copy to .env — never commit real values.
# One-shot: ./deploy/setup-dramo.sh (generates secrets + starts stack)

# Database password for the postgres service
DB_PASSWORD=dramo_secret

# Encryption key for UserLLMConfig at rest (64 hex chars = 32 bytes)
# REQUIRED in production (NODE_ENV=production). Generate:
#   openssl rand -hex 32
ENCRYPTION_KEY=

# Mapped to AGENTOS_SECURITY_KEY in api + agentos containers
AGENTOS_KEY=default_agentos_key

# Public-facing URL (change for a real domain)
PUBLIC_URL=http://localhost

# Host port for Nginx (default 80)
PORT=80

# Stable Diffusion worker pool (A1111-compatible JSON). Injected into api.
# Docker: do NOT use 127.0.0.1 — that is the api container, not the host SD.
# Local `npm run dev` can omit this; code defaults to 127.0.0.1:7860 and :7861.
# SD_WORKERS=[{"id":"sd-1","baseUrl":"http://<sd-host>:7860","weight":1,"capabilities":["txt2img","img2img"]},{"id":"sd-2","baseUrl":"http://<sd-host>:7861","weight":1,"capabilities":["txt2img"]}]

# === AgentOS LLM tuning (optional) ===
# LLM_TIMEOUT_SECONDS=90
# LLM_MAX_RETRIES=2
