# Story Agent Backend — Environment Configuration
# Copy this file to .env and fill in the actual values
# Architecture: Hono + Vercel Serverless + Supabase + AgentOS (独立部署)

# =================================
# SERVER CONFIGURATION
# =================================
NODE_ENV=development
PORT=12321
LOG_LEVEL=info

# =================================
# DATABASE (Supabase PostgreSQL)
# =================================
# Local dev: use direct connection (port 5432)
# Vercel prod: use connection pooler (port 6543) for serverless
DATABASE_URL=postgresql://postgres:[YOUR_PASSWORD]@db.xxxxx.supabase.co:5432/postgres

# =================================
# AUTHENTICATION
# =================================
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=30d

# =================================
# AGENTOS (Python AI Service — independently deployed)
# =================================
# Docker: http://agentos:12322
# Local dev: http://localhost:12322
# Production: https://your-agentos-host.example.com
AGENTOS_BASE_URL=http://localhost:12322
# Optional: bearer token for AgentOS security
# AGENTOS_SECURITY_KEY=your-security-key

# =================================
# ENCRYPTION (for user API key storage)
# =================================
# 64 hex characters (32 bytes / 256 bits) for AES-256-GCM
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# =================================
# AI PROVIDER CONFIGURATION (DEPRECATED — users now provide their own keys)
# Kept for backward compatibility during transition.
# =================================
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_MODEL_ID=gpt-4-turbo-preview
# Optional: custom gateway endpoint
# OPENAI_API_BASE=https://api.openai.com/v1

# Hunyuan (Tencent) — alternative provider
# HUNYUAN_OPENAPI_KEY=your-hunyuan-api-key
# HUNYUAN_MODEL_ID=hunyuan-turbos-latest
# HUNYUAN_OPENAPI_URL=https://hunyuan.tencentcloudapi.com

# Image generation (Doubao Seedream via ARK)
# ARK_API_KEY=your-doubao-seedream-api-key

# =================================
# STORAGE (Supabase Storage)
# =================================
# 'supabase' (production) or 'local' (dev fallback)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_BASE_URL=http://localhost:12321/uploads

# Supabase Storage (required when STORAGE_DRIVER=supabase)
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_BUCKET=images
# SUPABASE_SIGNED_URL_TTL=600

# =================================
# SSE CONFIGURATION (optional — sensible defaults)
# =================================
# SSE_TIMEOUT_MS=55000    # 55s (5s safety margin for Vercel 60s limit)
# SSE_HEARTBEAT_MS=15000  # 15s heartbeat interval

# =================================
# STRIPE BILLING
# =================================
# Create Products & Prices in Stripe Dashboard, paste IDs here
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_PRO_MONTHLY=price_xxx
STRIPE_PRICE_PRO_YEARLY=price_xxx

# Frontend URL (for Checkout success/cancel redirects)
FRONTEND_URL=http://localhost:12323

# =================================
# AGENTOS-ONLY ENV VARS (read by agentos/env_loader.py)
# =================================
# AGENTOS_PORT=12322
# LLM_CONCURRENCY=3
# AGNO_TELEMETRY=false
