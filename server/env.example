# Dramo Server — copy to .env
# Hono + Prisma + PostgreSQL + AgentOS. LLM keys live in UserLLMConfig, not here.

NODE_ENV=development
PORT=12321
LOG_LEVEL=info

# Docker: postgresql://dramo:dramo_secret@postgres:5432/dramo
DATABASE_URL=postgresql://dramo:dramo_secret@localhost:5432/dramo
# DIRECT_URL=postgresql://dramo:dramo_secret@localhost:5432/dramo

AGENTOS_BASE_URL=http://localhost:12322
AGENTOS_SECURITY_KEY=default_agentos_key

# Generate: openssl rand -hex 32
# Required in production. 64 hex characters.
ENCRYPTION_KEY=

STORAGE_LOCAL_DIR=./uploads
STORAGE_BASE_URL=http://localhost:12321/uploads

FRONTEND_URL=http://localhost:12323

# SSE_TIMEOUT_MS=55000
# SSE_HEARTBEAT_MS=15000

# Local default is 127.0.0.1:7860/7861. Required in Docker via compose.
# SD_WORKERS=[{"id":"sd-1","baseUrl":"http://127.0.0.1:7860","weight":1,"capabilities":["txt2img","img2img"]},{"id":"sd-2","baseUrl":"http://127.0.0.1:7861","weight":1,"capabilities":["txt2img"]}]

# Read by agentos/env_loader.py from this file when running locally
# LLM_CONCURRENCY=3
# LLM_TIMEOUT_SECONDS=90
# LLM_TIMEOUT_LONG_SECONDS=180
# LLM_MAX_RETRIES=2
# DETAIL_REFINER_TIMEOUT_SECONDS=200
