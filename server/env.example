# Dramo Server — Environment Configuration
# Copy this file to .env and fill in the actual values
# Architecture: Hono v4 + Prisma 5 + PostgreSQL (local) + AgentOS (Python)

# =================================
# SERVER
# =================================
NODE_ENV=development
PORT=12321
LOG_LEVEL=info

# =================================
# DATABASE (local PostgreSQL container)
# =================================
# Docker: postgresql://dramo:dramo_secret@postgres:5432/dramo
# Local:  postgresql://dramo:dramo_secret@localhost:5432/dramo
DATABASE_URL=postgresql://dramo:dramo_secret@localhost:5432/dramo

# Optional: separate connection for Prisma migrations (defaults to DATABASE_URL)
# DIRECT_URL=postgresql://dramo:dramo_secret@localhost:5432/dramo

# =================================
# AGENTOS (Python AI Service)
# =================================
# Docker: http://agentos:12322
# Local:  http://localhost:12322
AGENTOS_BASE_URL=http://localhost:12322
AGENTOS_SECURITY_KEY=default_agentos_key

# =================================
# ENCRYPTION (LLM API key storage)
# =================================
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production. 64 hex characters = 32 bytes for AES-256-GCM.
ENCRYPTION_KEY=

# =================================
# STORAGE (local filesystem)
# =================================
STORAGE_LOCAL_DIR=./uploads
STORAGE_BASE_URL=http://localhost:12321/uploads

# =================================
# SSE
# =================================
# SSE_TIMEOUT_MS=55000
# SSE_HEARTBEAT_MS=15000

# =================================
# AGENTOS-ONLY ENV VARS (read by agentos/env_loader.py)
# When running locally, agentos reads these from server/.env via env_loader.
# In Docker, they are injected directly via docker-compose.yml.
# =================================
# OPENAI_API_KEY=sk-...
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_MODEL_ID=gpt-4-turbo-preview
# ARK_API_KEY=
# LLM_CONCURRENCY=3
# LLM_TIMEOUT_SECONDS=90
# LLM_TIMEOUT_LONG_SECONDS=180
# LLM_MAX_RETRIES=2
