datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ProjectType {
  script
  cinema
  spoken
}

enum ScreenplayFormat {
  hollywood
  asian
}

enum MemberRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships     ProjectMember[]
  llmConfigs      UserLLMConfig[]
  sessions        Session[]
  generationTasks GenerationTask[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum LLMConfigType {
  TEXT_LLM
}

model UserLLMConfig {
  id        String        @id @default(cuid())
  userId    String
  name      String
  type      LLMConfigType
  baseUrl   String
  apiKey    String
  modelId   String
  isDefault Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId, type, isDefault])
}

model Project {
  id          String           @id @default(cuid())
  name        String
  description String?
  type        ProjectType      @default(script)
  format      ScreenplayFormat @default(hollywood)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  members         ProjectMember[]
  episodes        Episode[]
  characters      Character[]
  locations       Location[]
  props           Prop[]
  advisorId       String?
  worldviewRules  WorldviewRule[]
  knowledgeFiles  KnowledgeFile[]
  assets          Asset[]
  generationTasks GenerationTask[]
  chatSessions    ChatSession[]

  @@index([createdAt])
}

model ProjectMember {
  id        String     @id @default(cuid())
  projectId String
  userId    String
  role      MemberRole @default(OWNER)
  craft     String?
  createdAt DateTime   @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Episode {
  id        String   @id @default(cuid())
  projectId String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  screenplay Screenplay?
  outline    Outline?
  beats      Beat[]
  scenes     Scene[]
  shots      Shot[]
  coldStart  Json      @default("{}")

  @@index([projectId, sortOrder])
}

model Scene {
  id           String   @id @default(cuid())
  episodeId    String
  heading      String
  locationName String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  shots   Shot[]

  @@unique([episodeId, heading])
  @@index([episodeId, sortOrder])
}

model Shot {
  id          String   @id @default(cuid())
  episodeId   String
  sceneId     String
  sortOrder   Int      @default(0)
  description String   @default("")
  camera      String   @default("")
  design      String   @default("")
  stale       Boolean  @default(false)
  images      Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  scene   Scene   @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@index([episodeId, sortOrder])
  @@index([sceneId])
}

model Outline {
  id        String   @id @default(cuid())
  episodeId String   @unique
  markdown  String   @default("")
  updatedAt DateTime @updatedAt

  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
}

model Beat {
  id        String   @id @default(cuid())
  episodeId String
  sortOrder Int      @default(0)
  action    String   @default("")
  intent    String   @default("")
  outcome   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([episodeId, sortOrder])
}

model Screenplay {
  id        String   @id @default(cuid())
  episodeId String   @unique
  title     String
  cover     Json     @default("{}")
  nodes     Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  episode  Episode             @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  versions ScreenplayVersion[]
}

model ScreenplayVersion {
  id           String   @id @default(cuid())
  screenplayId String
  version      Int
  summary      String?
  cover        Json
  nodes        Json
  createdAt    DateTime @default(now())

  screenplay Screenplay @relation(fields: [screenplayId], references: [id], onDelete: Cascade)

  @@unique([screenplayId, version])
  @@index([screenplayId, createdAt])
}

model Character {
  id           String   @id @default(cuid())
  projectId    String
  name         String
  description  String?
  castingNotes String?
  images       Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId])
}

model Location {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String?
  storyPlace  String?
  shootPlace  String?
  images      Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId])
}

model Prop {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String?
  holder      String?
  continuity  String?
  images      Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId])
}

model KnowledgeFile {
  id        String   @id @default(cuid())
  projectId String
  name      String
  filename  String
  mime      String   @default("text/plain")
  text      String   @default("")
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model WorldviewRule {
  id        String   @id @default(cuid())
  projectId String
  key       String
  value     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
  @@index([projectId])
}

model Asset {
  id         String   @id @default(cuid())
  projectId  String
  kind       String
  entityType String?
  entityId   String?
  url        String
  taskId     String?
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, kind])
  @@index([entityType, entityId])
}

model GenerationTask {
  id          String   @id @default(cuid())
  userId      String
  projectId   String
  kind        String
  entityType  String?
  entityId    String?
  prompt      String
  aspectRatio String?
  status      String   @default("queued")
  progress    Int      @default(0)
  workerId    String?
  resultUrl   String?
  error       Json?
  retryCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([projectId])
  @@index([status, createdAt])
}

model ChatSession {
  id        String   @id @default(cuid())
  projectId String
  title     String   @default("新对话")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([projectId, updatedAt])
}

model ChatMessage {
  id          String   @id @default(cuid())
  sessionId   String
  role        String
  content     String
  messageType String?
  createdAt   DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}
