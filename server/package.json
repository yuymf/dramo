{
  "name": "@dramo/server",
  "version": "2.0.0",
  "description": "AI story script generation — Hono + Vercel + Supabase",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file .env src/server.ts",
    "build": "prisma generate && tsc && node scripts/fix-esm-imports.js",
    "start": "node dist/server.js",
    "vercel-dev": "vercel dev",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "lint": "eslint src --ext .ts",
    "test": "jest"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "@prisma/client": "^5.10.2",
    "@supabase/supabase-js": "^2.39.7",
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0",
    "csv-parse": "^6.1.0",
    "hono": "^4.12.7",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.11.0",
    "openai": "^6.6.0",
    "pdf-parse": "^2.4.5",
    "pino": "^8.19.0",
    "pino-pretty": "^10.3.1",
    "stripe": "^20.4.1",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.19",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "@typescript-eslint/parser": "^7.0.1",
    "eslint": "^8.56.0",
    "jest": "^30.3.0",
    "prisma": "^5.10.2",
    "ts-jest": "^29.4.6",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  },
  "prisma": {
    "schema": "src/db/schema.prisma"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
